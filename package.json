{
  "name": "sals",
  "version": "0.1.0",
  "description": "Simple Ansible Language Server",
  "license": "MIT",
  "type": "module",
  "bin": "dist/cli.cjs",
  "main": "dist/cli.cjs",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acsezen/sals.git"
  },
  "bugs": {
    "url": "https://github.com/acsezen/sals/issues"
  },
  "homepage": "https://github.com/acsezen/sals#readme",
  "keywords": [
    "ansible",
    "language-server",
    "lsp"
  ],
  "scripts": {
    "clean": "rimraf dist out coverage",
    "build": "tsup --silent",
    "watch": "tsup --watch --silent",
    "start": "node dist/cli.cjs --stdio",
    "test": "vitest run",
    "test-with-ee": "vitest run -t @ee",
    "test-without-ee": "SKIP_PODMAN=1 SKIP_DOCKER=1 vitest run",
    "validate-ls": "tsx test/validate-ls.ts"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "^2.0.3",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "antsibull-docs": "^1.1.4",
    "glob": "^13.0.6",
    "ini": "^6.0.0",
    "lodash": "^4.17.23",
    "uuid": "^14.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-uri": "^3.1.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "fuse.js": "^7.1.0",
    "rimraf": "^6.1.3",
    "shell-quote": "^1.9.0",
    "sinon": "^21.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "vscode-jsonrpc": "^8.2.1"
  }
}
